function run_spec(command, spec, user_args) {
    let module = module_path(spec[0]);
    if (!file_readable(module)) {
        warn("Error: required file '", module, "' is missing or not readable\n");
        restore_dnsmasq_failsafe_on_loader_failure(command);
        return 1;
    }

    let args = [ "ucode", "-L", LIB_DIR, module, spec[1] ];
    let count = int(spec[2] || 0);
    for (let i = 0; i < count; i++)
        push(args, user_args[i] || "");

    return normalize_status(system(command_from_args(args)));
}

// While a full removal runs (full-uninstall.sh holds this lock), only the
// commands that read and the removal's own steps may run (UC-084): any other
// changes Prokop's configuration, its snapshots, its scheduled jobs, its
// packages or its runtime, and could bring back what the removal takes away.
// The list names what may run, so a command added later is refused until it
// is known to be harmless here.
//
// The lock is a directory in /var/run/prokop (only root writes there) whose
// pid file names the removal's starter or worker (full-uninstall.sh). It
// counts only while that process runs: a removal killed by SIGKILL, or by a
// HUP when its SSH session closed, blocked every start, reload and restart
// until a reboot, and so could any user with a mkdir in /tmp (CFG-3). A lock
// without a pid file yet is the starter's own, for a minute.
const FULL_UNINSTALL_LOCK = getenv("PROKOP_FULL_UNINSTALL_LOCK") || "/var/run/prokop/full-uninstall.lock";
const FULL_UNINSTALL_LOCK_SETUP_SECONDS = 60;
const ALLOWED_DURING_FULL_UNINSTALL = [
    // The removal's own steps: init.d stop, the kill-switch removal, the
    // dnsmasq restore, the package's prerm; a second removal answers itself.
    "stop", "disable", "killswitch_disable", "dnsmasq_restore", "restore_dnsmasq", "package_prerm",
    "full_uninstall", "uninstall",
    // What only reads.
    "killswitch_status", "show_config", "show_version", "show_sing_box_config", "show_sing_box_version",
    "check_proxy", "check_nft", "check_nft_rules", "check_sing_box", "check_logs", "check_sing_box_logs",
    "check_fakeip", "check_zapret_runtime", "check_zapret2_runtime", "check_byedpi_runtime",
    "check_dns_available", "get_status", "get_outbound_metadata", "get_subscription_metadata",
    "get_sing_box_status", "get_zapret_status", "get_zapret2_status", "get_byedpi_status", "get_system_info",
    "get_ui_capabilities", "get_ui_state", "get_health_status", "get_history", "get_readonly_config_sections",
    "get_dashboard_runtime_metadata", "route_trace", "connectivity_test", "global_check", "support_report",
    "config_snapshot_list", "config_snapshot_diff", "service_action_status", "latency_test_status",
    "component_action_status", "subscription_update_status", "component_update_check_cache",
    "prokop_releases", "autotune_status", "autotune_target", "autotune_groups", "autotune_list_domains",
    "autotune_run_status", "validate_nfqws_strategy_json", "validate_nfqws2_strategy_json",
    "validate_byedpi_strategy_json"
];

function full_uninstall_running() {
    let lock = fs.lstat(FULL_UNINSTALL_LOCK);
    if (lock == null || lock.type != "directory")
        return false;
    let pid = trim(as_string(fs.readfile(FULL_UNINSTALL_LOCK + "/pid")));
    if (match(pid, /^[1-9][0-9]*$/) == null) {
        let age = time() - int(lock.mtime || 0);
        return age >= 0 && age < FULL_UNINSTALL_LOCK_SETUP_SECONDS;
    }
    let argv = join(" ", split(as_string(fs.readfile("/proc/" + pid + "/cmdline")), "\u0000"));
    return index(argv, "full-uninstall") >= 0 || index(argv, "/worker.sh worker ") >= 0;
}

function refused_during_full_uninstall(command, user_args) {
    if (!full_uninstall_running())
        return false;
    // The Clash API reads with get_*; its other actions change the runtime.
    if (command == "clash_api")
        return substr(as_string(user_args[0]), 0, 4) != "get_";
    return index(ALLOWED_DURING_FULL_UNINSTALL, command) < 0;
}

function main() {
    let command = ARGV[0] || "";
    let spec = command_spec(command);
    if (spec == null) {
        show_help();
        return 1;
    }

    let user_args = [];
    for (let i = 1; i < length(ARGV); i++)
        push(user_args, ARGV[i]);

    if (refused_during_full_uninstall(command, user_args)) {
        warn("Prokop full removal is in progress\n");
        return 1;
    }

    return run_spec(command, spec, user_args);
}

exit(main());
