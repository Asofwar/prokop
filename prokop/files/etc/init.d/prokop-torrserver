#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

# TorrServer installed by Prokop (components/action.uc, torrserver/manager.uc).
# It runs only the binary Prokop installed, which its marker names: a
# TorrServer installed by other means is not this service's. procd keeps it
# in its own cgroup, which TorrServer Direct needs.
#
# TorrServer talks to any peer on the internet and serves the LAN: it runs
# as its own unprivileged user, never root (TS-1). Its database lives in
# data/, the only directory that user may write; the binary, Prokop's
# marker and the directory that holds them stay root's, so TorrServer can
# neither replace its own program nor plant links where Prokop writes.
#
# Prokop's settings add, both off by default: a password for TorrServer's
# API (torrserver_auth_*, --httpauth with data/accs.db), and procd's jail
# (torrserver_jail), which shows TorrServer only its binary, its data,
# its disk cache and what it needs to resolve names and check
# certificates. A setting that cannot be honoured stops the start: never
# an open API when a password is asked for, never an unjailed TorrServer
# when the jail is.
START=95
STOP=10
USE_PROCD=1

TORRSERVER_DIR=/opt/torrserver
TORRSERVER_DATA="$TORRSERVER_DIR/data"
TORRSERVER_USER=torrserver
PASSWD_FILE=/etc/passwd
GROUP_FILE=/etc/group
PROKOP_LIB=/usr/lib/prokop
UCODE=/usr/bin/ucode
UJAIL=/sbin/ujail
# What TorrServer's own settings of Prokop were when it started (a digest),
# so that a change of Prokop's other settings does not restart it.
OPTIONS_STAMP=/var/run/prokop-torrserver.options

torrserver_option() {
	uci -q get "prokop.settings.$1"
}

torrserver_manager() {
	PROKOP_TORRSERVER_DIR="$TORRSERVER_DIR" "$UCODE" -L "$PROKOP_LIB" "$PROKOP_LIB/torrserver/manager.uc" "$@"
}

# A digest of the settings that need a restart of TorrServer: the
# password (only while it is on) and the jail. "auth=0 jail=0" alone is
# what a TorrServer started before these settings existed runs with.
torrserver_options_stamp() {
	local auth jail
	auth="$(torrserver_option torrserver_auth_enabled)"
	[ "$auth" = 1 ] || auth=0
	jail="$(torrserver_option torrserver_jail)"
	[ "$jail" = 1 ] || jail=0
	{
		echo "auth=$auth jail=$jail"
		if [ "$auth" = 1 ]; then
			torrserver_option torrserver_auth_user
			torrserver_option torrserver_auth_password
		fi
	} | md5sum | cut -d' ' -f1
}

# The system user TorrServer runs as, created on first use as OpenWrt's
# packages create theirs (add_group_and_user): a group from 65536 up, and a
# user with the same id. False when it cannot be made.
ensure_torrserver_user() {
	local id
	if user_exists "$TORRSERVER_USER"; then
		return 0
	fi
	if group_exists "$TORRSERVER_USER"; then
		id="$(grep -s "^$TORRSERVER_USER:" "$GROUP_FILE" | cut -d: -f3)"
	else
		id=65536
		while grep -qs "^[^:]*:[^:]*:$id:" "$PASSWD_FILE" "$GROUP_FILE"; do
			id=$((id + 1))
		done
		group_add "$TORRSERVER_USER" "$id" || return 1
	fi
	case "$id" in ''|*[!0-9]*) return 1 ;; esac
	# Never share an id with another user.
	grep -qs "^[^:]*:[^:]*:$id:" "$PASSWD_FILE" && return 1
	user_add "$TORRSERVER_USER" "$id" "$id" TorrServer "$TORRSERVER_DATA" /bin/false || return 1
	user_exists "$TORRSERVER_USER"
}

# data/ for TorrServer's user. A TorrServer from before kept its database
# beside the binary and ran as root: the database moves in once. The
# database is that user's on every start, also one a sysupgrade restored
# (lib/upgrade/keep.d/prokop-torrserver). Nothing is changed recursively,
# and links are never followed.
prepare_torrserver_data() {
	local name
	[ -L "$TORRSERVER_DIR" ] && return 1
	# TorrServer's user must pass through the directory that holds its
	# binary and data/: Prokop's updater runs under umask 077, and the
	# directory a release before TS-1 created is 0700. It stays root's, so
	# that user still writes nothing in it.
	chmod 0755 "$TORRSERVER_DIR" || return 1
	[ -L "$TORRSERVER_DATA" ] && return 1
	[ -d "$TORRSERVER_DATA" ] || mkdir -m 0750 "$TORRSERVER_DATA" || return 1
	chown -h "$TORRSERVER_USER:$TORRSERVER_USER" "$TORRSERVER_DATA" || return 1
	# settings.json holds the settings when StoreSettingsInJson is on, and
	# viewed.json what was watched: they move in with the database.
	for name in config.db settings.json viewed.json rutor.ls; do
		if [ -f "$TORRSERVER_DIR/$name" ] && [ ! -L "$TORRSERVER_DIR/$name" ] && [ ! -e "$TORRSERVER_DATA/$name" ]; then
			mv "$TORRSERVER_DIR/$name" "$TORRSERVER_DATA/$name" || return 1
		fi
		[ -f "$TORRSERVER_DATA/$name" ] && [ ! -L "$TORRSERVER_DATA/$name" ] || continue
		chown -h "$TORRSERVER_USER:$TORRSERVER_USER" "$TORRSERVER_DATA/$name" || return 1
	done
	return 0
}

# What TorrServer needs to see in its jail besides its binary and data:
# names (resolv.conf and where OpenWrt links it, hosts), certificates,
# the time zone. Only those that exist: ujail refuses a missing one.
torrserver_jail_mounts() {
	local path
	for path in /dev/null /dev/urandom /etc/ssl /etc/resolv.conf /tmp/resolv.conf /tmp/resolv.conf.d \
		/tmp/resolv.conf.auto /etc/hosts /etc/TZ /etc/localtime; do
		[ -e "$path" ] && echo "$path"
	done
}

start_service() {
	local stamp auth jail memlimit
	[ -x "$TORRSERVER_DIR/torrserver" ] && [ -f "$TORRSERVER_DIR/prokop-managed.json" ] || return 0
	# Fail closed: without its own user TorrServer does not run at all.
	if ! ensure_torrserver_user || ! prepare_torrserver_data; then
		logger -t prokop-torrserver "TorrServer was not started: its user $TORRSERVER_USER or $TORRSERVER_DATA could not be prepared"
		return 1
	fi
	stamp="$(torrserver_options_stamp)"
	# The password of its API: accs.db is written (or removed) by the
	# manager and read by TorrServer's user alone.
	auth="$(torrserver_manager prepare-auth)" || auth=""
	case "$auth" in
		on)
			if ! chown -h "$TORRSERVER_USER:$TORRSERVER_USER" "$TORRSERVER_DATA/accs.db"; then
				logger -t prokop-torrserver "TorrServer was not started: its password file could not be handed to $TORRSERVER_USER"
				return 1
			fi
			;;
		off) ;;
		*)
			logger -t prokop-torrserver "TorrServer was not started: its password is on, but the user name or password is missing or unusable"
			return 1
			;;
	esac
	jail="$(torrserver_option torrserver_jail)"
	if [ "$jail" = 1 ] && [ ! -x "$UJAIL" ]; then
		logger -t prokop-torrserver "TorrServer was not started: its jail is on, but this firmware has no $UJAIL (procd-ujail)"
		return 1
	fi
	# A soft limit for Go's heap (torrserver/manager.uc memlimit-mib):
	# TorrServer's cache and some room. Go collects garbage sooner near it
	# and never stops TorrServer for it. None when it cannot be told.
	memlimit="$(torrserver_manager memlimit-mib 2>/dev/null)" || memlimit=""
	case "$memlimit" in ''|*[!0-9]*) memlimit="" ;; esac
	procd_open_instance torrserver
	if [ "$auth" = on ]; then
		procd_set_param command "$TORRSERVER_DIR/torrserver" -d "$TORRSERVER_DATA" -p 8090 --httpauth
	else
		procd_set_param command "$TORRSERVER_DIR/torrserver" -d "$TORRSERVER_DATA" -p 8090
	fi
	procd_set_param user "$TORRSERVER_USER"
	procd_set_param no_new_privs 1
	# Go returns freed memory to the router at once (as TorrServer's own
	# systemd unit sets).
	if [ -n "$memlimit" ]; then
		procd_set_param env GODEBUG=madvdontneed=1 HOME="$TORRSERVER_DATA" GOMEMLIMIT="${memlimit}MiB"
	else
		procd_set_param env GODEBUG=madvdontneed=1 HOME="$TORRSERVER_DATA"
	fi
	procd_set_param limits nofile="4096 4096"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	if [ "$jail" = 1 ]; then
		# requirejail: procd itself refuses to run it unjailed. ujail runs
		# TorrServer as its child in this instance's cgroup (it moves a
		# process only for an OCI container), which TorrServer Direct marks.
		procd_add_jail torrserver procfs requirejail
		# shellcheck disable=SC2046 # one path per line, none with spaces
		procd_add_jail_mount "$TORRSERVER_DIR/torrserver" $(torrserver_jail_mounts)
		# shellcheck disable=SC2046
		procd_add_jail_mount_rw "$TORRSERVER_DATA" $(torrserver_manager disk-cache-dirs 2>/dev/null)
	fi
	procd_close_instance
	(umask 077 && echo "$stamp" >"$OPTIONS_STAMP") || true
}

# Prokop's settings changed (LuCI's Save & Apply): TorrServer restarts
# only when its own did. Its playback is not cut for anything else.
service_triggers() {
	procd_add_reload_trigger prokop
}

reload_service() {
	local recorded
	recorded="$(cat "$OPTIONS_STAMP" 2>/dev/null)" || recorded=""
	[ -n "$recorded" ] || recorded="$(echo "auth=0 jail=0" | md5sum | cut -d' ' -f1)"
	[ "$(torrserver_options_stamp)" = "$recorded" ] && return 0
	stop
	start
}
