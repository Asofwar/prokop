#!/bin/sh /etc/rc.common
# Optional local SOCKS providers. All instances belong to this procd service.
# shellcheck disable=SC2034
USE_PROCD=1
STOP=02
LIB=/usr/lib/prokop
DIR=/var/run/prokop-sidecars

provider_instance() {
    local name="$1" kind
    case "$name" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
    kind=$(ucode -L "$LIB" "$LIB/experiments/sidecars.uc" kind "$name") || return 1
    procd_open_instance "$name"
    case "$kind" in
        xray) procd_set_param command /usr/bin/xray run -config "$DIR/$name.json" ;;
        wdtt) procd_set_param command /usr/bin/qwdtt-client -config "$DIR/$name.json" ;;
        olcrtc) procd_set_param command /usr/bin/olcrtc "$DIR/$name.json" ;;
        *) procd_close_instance; return 1 ;;
    esac
    procd_set_param user prokop-sidecar
    procd_set_param respawn 3600 5 5
    procd_set_param file "$DIR/$name.json"
    # Provider logs may include access tokens; keep them out of logread/support bundles.
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
start_service() {
    ucode -L "$LIB" "$LIB/experiments/sidecars.uc" prepare >/dev/null || return 1
    local names name
    names=$(ucode -L "$LIB" "$LIB/experiments/sidecars.uc" names) || return 1
    for name in $names; do provider_instance "$name" || return 1; done
}
