#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

# rc.d orders its links by name: two digits, so that TorrServer Direct starts
# after Prokop (START=99, S99prokop sorts first) and stops early at shutdown,
# and rc.common's disable (S??, K??) removes the links again (UC-161).
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ "$(uci -q get prokop.settings.torrserver_direct_enabled)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/ucode -L /usr/lib/prokop /usr/lib/prokop/torrserver/direct.uc worker
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/bin/ucode -L /usr/lib/prokop /usr/lib/prokop/torrserver/direct.uc remove >/dev/null 2>&1 || true
}
