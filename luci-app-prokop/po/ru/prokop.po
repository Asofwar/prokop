msgstr "%d ч"

msgid "%d h ago"
msgstr "%d ч назад"

msgid "%d min"
msgstr "%d мин"

msgid "%d min ago"
msgstr "%d мин назад"

msgid "%d more groups"
msgstr "Ещё групп: %d"

msgid "%d more: refine the search"
msgstr "ещё %d: уточните поиск"

msgid "%d ms"
msgstr "%d мс"

msgid "%d node groups"
msgstr "Групп узлов: %d"

msgid "%d of %d checks passed"
msgstr "Пройдено проверок: %d из %d"

msgid "%d of %d checks failed"
msgstr "Не прошло проверок: %d из %d"

msgid "%d rules"
msgstr "Правил: %d"

msgid "%d rules · %d node groups"
msgstr "Правил: %d · групп узлов: %d"

msgid "%s (disabled)"
msgstr "%s (отключена)"

msgid "%s (not installed)"
msgstr "%s (не установлен)"

msgid "%s (provider not installed)"
msgstr "%s (провайдер не установлен)"

msgid "%s (unavailable)"
msgstr "%s (недоступна)"

msgid "%s B"
msgstr "%s Б"

msgid "%s h %s min"
msgstr "%s ч %s мин"

msgid "%s has been disabled"
msgstr "%s выключен"

msgid "%s has been enabled"
msgstr "%s включён"

msgid "%s has been installed"
msgstr "%s установлен"

msgid "%s has been removed"
msgstr "%s удалён"

msgid "%s has been started"
msgstr "%s запущен"

msgid "%s in the rule \"%t\""
msgstr "%s в правиле «%t»"

msgid "%s is “%s”: sing-box and the firewall read it differently"
msgstr "%s = «%s»: sing-box и файрвол читают это значение по-разному"

msgid "%s is not applied again before %t"
msgstr "%s не применяется повторно до %t"

msgid "%s is not installed. Install it in Components or choose another action."
msgstr "%s не установлен. Установите его в разделе «Компоненты» или выберите другое действие."

msgid "%s KB"
msgstr "%s КБ"

msgid "%s MB"
msgstr "%s МБ"

msgid "%s min %s s"
msgstr "%s мин %s с"

msgid "%s of %s (%s%)"
msgstr "%s из %s (%s%)"

msgid "%s received"
msgstr "получено %s"

msgid "%s s"
msgstr "%s с"

msgid "%s: “%s” cannot be written in the current form unchanged"
msgstr "%s: «%s» нельзя записать в текущем виде без изменения смысла"

msgid "%s: not moved to the Device filter, the rule has no destination condition and does not use it"
msgstr "%s: не переносится в «Фильтр по устройствам» — у правила нет условия назначения, и он не используется"

msgid "%s/s"
msgstr "%s/с"

msgid "+ Add JSON outbound"
msgstr "+ Добавить JSON outbound"

msgid "+ Add level"
msgstr "+ Добавить уровень"

msgid "+ Add priority"
msgstr "+ Добавить приоритет"

msgid "+ Add URLTest"
msgstr "+ Добавить URLTest"

msgid "0–5; 0 turns automatic changes off."
msgstr "0–5; 0 отключает автоматические изменения."

msgid "1–8 domains, spread evenly over the list; a domain without an address is replaced by the next one."
msgstr "1–8 доменов, равномерно по списку; домен без адреса заменяется следующим."

msgid "25 connections per torrent, disconnect after 30 seconds"
msgstr "25 соединений на торрент, отключение через 30 секунд"

msgid "3–7 attempts per strategy and target in each check."
msgstr "3–7 попыток на стратегию и цель в каждой проверке."

msgid "A check is already running."
msgstr "Проверка уже идёт."

msgid "A configuration backup will be saved in /etc/prokop-backups. Older versions may not support all current settings."
msgstr "Резервная копия настроек будет сохранена в /etc/prokop-backups. Старые версии могут поддерживать не все текущие настройки."

msgid "A configuration change did not finish and its protection is still active. Restore a snapshot in History and recovery."
msgstr "Изменение конфигурации не завершилось, и его защита всё ещё активна. Восстановите снимок в разделе «История и восстановление»."

msgid "A configuration change is being applied. Traffic that needs DPI bypass may be blocked until it finishes."
msgstr "Применяется изменение конфигурации. Трафик, которому нужен обход DPI, может блокироваться, пока оно не завершится."

msgid "A configuration change was not confirmed. Traffic that needs DPI bypass may be blocked; see the recovery details for the next step."
msgstr "Изменение конфигурации не подтвердилось. Трафик, которому нужен обход DPI, может блокироваться; следующий шаг указан в подробностях о восстановлении."

msgid "A configuration restore did not finish: restore the last known good snapshot to finish it."
msgstr "Восстановление конфигурации не завершено: чтобы завершить его, восстановите снимок последней рабочей конфигурации."

msgid "A configuration restore did not finish. Traffic that needs DPI bypass stays blocked until you restore the last known good snapshot."
msgstr "Восстановление конфигурации не завершено. Трафик, которому нужен обход DPI, блокируется, пока вы не восстановите снимок последней рабочей конфигурации."

msgid "A Connection rule needs a connection: add a connection URL, a subscription, a network interface or a JSON outbound, or disable the rule."
msgstr "Правилу «Подключение» нужно подключение: добавьте URL подключения, подписку, сетевой интерфейс или JSON outbound либо выключите правило."

msgid "A connection rule or sing-box stops answering, and when it is back. Checked every 5 minutes"
msgstr "Правило с подключением или sing-box перестали отвечать, и когда они снова работают. Проверка раз в 5 минут"

msgid "A domain, or a list of a DPI rule measured through a few of its domains."
msgstr "Домен или список DPI-правила, который проверяется по нескольким его доменам."

msgid "a failed change left the DPI guard in place; restart Prokop"
msgstr "неудавшееся изменение оставило защиту DPI; перезапустите Prokop"

msgid "A failed change left the DPI guard in place: restart Prokop to remove it."
msgstr "Неудавшееся изменение оставило защиту DPI: чтобы снять её, перезапустите Prokop."

msgid "A failed change left the DPI guard in place. Traffic that needs DPI bypass stays blocked until you restart Prokop."
msgstr "Неудавшееся изменение оставило защиту DPI. Трафик, которому нужен обход DPI, блокируется, пока вы не перезапустите Prokop."

msgid "A failed reload, start or snapshot restore, an autotune rollback"
msgstr "Неудачная перезагрузка, запуск или восстановление снимка, откат автотюна"

msgid "a FakeIP address is routed by its domain; check the site by its name"
msgstr "адрес FakeIP маршрутизируется по своему домену; проверьте сайт по имени"

msgid "A group is one Zapret DPI rule. Prokop changes only the strategy of an existing rule, for all its targets at once. It never creates or deletes rules and never turns DPI bypass off."
msgstr "Группа — это одно DPI-правило Zapret. Prokop меняет только стратегию существующего правила, сразу для всех его целей. Он никогда не создаёт и не удаляет правила и не отключает обход DPI."

msgid "A list of a DPI rule. Each check takes a few of its domains; keywords and regular expressions are skipped."
msgstr "Список DPI-правила. Каждая проверка берёт несколько его доменов; ключевые слова и регулярные выражения пропускаются."

msgid "A POST to this address, for ntfy, Gotify and similar services. The saved address is never shown on the page"
msgstr "POST-запрос на этот адрес, для ntfy, Gotify и похожих сервисов. Сохранённый адрес на странице не показывается"

msgid "a previous apply is not resolved"
msgstr "предыдущее применение не завершено"

msgid "A rolled back strategy is not applied again before this time passes."
msgstr "Откаченная стратегия не применяется снова, пока не пройдёт это время."

msgid "a rule applies to selected devices only; choose a device"
msgstr "одно из правил действует только для отдельных устройств — выберите устройство"

msgid "A rule blocks this address. This is intended for ads and trackers."
msgstr "Адрес блокируется правилом. Так и задумано для рекламы и трекеров."

msgid "a rule is too complex to calculate"
msgstr "правило слишком сложное для расчёта"

msgid "a rule on the way re-resolves the address, so the route depends on its answer"
msgstr "правило на пути заново определяет адрес, поэтому маршрут зависит от его ответа"

msgid "a rule on the way uses a list or pattern whose contents cannot be checked here"
msgstr "правило на пути использует список или шаблон, содержимое которого здесь проверить нельзя"

msgid "A safe isolated check is not possible right now."
msgstr "Безопасная изолированная проверка сейчас невозможна."

msgid "A site or service checked through the DPI rule that routes it."
msgstr "Сайт или сервис, который проверяется через DPI-правило, по которому он идёт."

msgid "a snapshot operation is in progress"
msgstr "идёт операция со снимком"

msgid "A strategy is being applied and checked; change the settings when it finishes."
msgstr "Сейчас применяется и проверяется стратегия; измените настройки, когда это закончится."

msgid "A strategy is set for the whole rule, so Prokop does not change it. You can split the targets into separate rules."
msgstr "Стратегия задаётся на всё правило, поэтому Prokop её не меняет. Можно разнести цели по разным правилам вручную."

msgid "A subscription fails to update, is about to expire, has expired or runs out of traffic"
msgstr "Подписка не обновилась, скоро истекает, истекла или заканчивается трафик"

msgid "about %d min"
msgstr "около %d мин"

msgid "Action"
msgstr "Действие"

msgid "Action completed"
msgstr "Действие выполнено"

msgid "Action required"
msgstr "Требуется действие"

msgid "Actions"
msgstr "Действия"

msgid "Active"
msgstr "Активные"

msgid "Active Bootstrap DNS"
msgstr "Активный Bootstrap DNS"

msgid "Active connections of all devices are interrupted."
msgstr "Активные соединения всех устройств будут прерваны."

msgid "Active Main DNS"
msgstr "Активный основной DNS"

msgid "Active until the next firewall reload"
msgstr "Действует до следующей перезагрузки файрвола"

msgid "Active: a change is being applied"
msgstr "Активна: применяется изменение"

msgid "Active: DPI switch not confirmed"
msgstr "Активна: переключение DPI не подтверждено"

msgid "Active: kept by a failed change"
msgstr "Активна: осталась после неудавшегося изменения"

msgid "Active: restore not finished"
msgstr "Активна: восстановление не завершено"

msgid "Add"
msgstr "Добавить"

msgid "Add %s to Built-in rule sets of this rule? When you save the rule, it also matches these lists."
msgstr "Добавить %s во встроенные наборы правил этого правила? После сохранения правило будет совпадать и с этими списками."

msgid "Add a rule"
msgstr "Добавить правило"

msgid "Add a target first"
msgstr "Сначала добавьте цель"

msgid "Add address"
msgstr "Добавить адрес"

msgid "Add at least one DNS server"
msgstr "Добавьте хотя бы один DNS-сервер"

msgid "Add prefix to nodes"
msgstr "Добавлять префикс к узлам"

msgid "Add target"
msgstr "Добавить цель"

msgid "add the interface item %s"
msgstr "добавить интерфейс %s"

msgid "add the interface item %s with the DNS resolver %s %s"
msgstr "добавить интерфейс %s с DNS-резолвером %s %s"

msgid "Add the sites that go through your DPI rules, for example youtube.com."
msgstr "Добавьте сайты, которые идут через ваши DPI-правила, например youtube.com."

msgid "Add URLs or local paths to .lst lists containing domains and subnets."
msgstr "Добавьте URL или локальные пути к спискам .lst с доменами и подсетями."

msgid "Add URLs or local paths to .lst lists containing domains. IP entries are ignored."
msgstr "Добавьте URL или локальные пути к спискам .lst с доменами. IP игнорируются."

msgid "Add URLs or local paths to .srs / .json lists. Only domain rules are supported."
msgstr "Добавьте URL или локальные пути к спискам .srs / .json. Поддерживаются только доменные правила."

msgid "Add URLs or local paths to .srs / .json lists. Subnets are ignored by default."
msgstr "Добавьте URL или локальные пути к спискам .srs / .json. Подсети по умолчанию игнорируются."

msgid "Add…"
msgstr "Добавить…"

msgid "Additional marking rules found"
msgstr "Найдены дополнительные правила маркировки"

msgid "Additionally exclude servers by protocol, transport, and security. Exclude only servers matching the specified parameters."
msgstr "Дополнительно исключать серверы по протоколу, транспорту и защите. Исключать только серверы, совпавшие по указанным параметрам."

msgid "Additionally filter servers by protocol, transport, and security. Add only servers matching the specified parameters."
msgstr "Дополнительно отбирать серверы по протоколу, транспорту и защите. Добавлять только серверы, совпавшие по указанным параметрам."

msgid "Address"
msgstr "Адрес"

msgid "Address set for checking"
msgstr "Набор адресов для проверки"

msgid "Adds X25519MLKEM768 to the TLS ClientHello of this rule's REALITY servers with the chrome fingerprint. Needed by REALITY servers on Xray-core 26.9.8 and newer (3x-ui 3.8.0 and newer) that answer with their mask site otherwise. Breaks REALITY servers without ML-KEM support: turn it on only for such servers."
msgstr "Добавляет X25519MLKEM768 в TLS ClientHello REALITY-серверов этого правила с отпечатком chrome. Нужно REALITY-серверам на Xray-core 26.9.8 и новее (3x-ui 3.8.0 и новее), которые без него отвечают маскировочным сайтом. Ломает REALITY-серверы без поддержки ML-KEM: включайте только для таких серверов."

msgid "Ads (Hagezi Pro)"
msgstr "Реклама (Hagezi Pro)"

msgid "Adult sites"
msgstr "Сайты для взрослых"

msgid "Advanced"
msgstr "Дополнительно"

msgid "Advanced settings"
msgstr "Дополнительные настройки"

msgid "After a change Prokop keeps checking it for %s; a strategy that fails twice in a row is rolled back."
msgstr "После изменения Prokop проверяет стратегию ещё %s; стратегия, которая дважды подряд не прошла проверку, откатывается."

msgid "All"
msgstr "Все"

msgid "All check results"
msgstr "Все результаты проверки"

msgid "All devices"
msgstr "Все устройства"

msgid "All events"
msgstr "Все события"

msgid "All except selected"
msgstr "Все, кроме выбранных"

msgid "All paths"
msgstr "Все пути"

msgid "All remaining except selected"
msgstr "Все оставшиеся, кроме выбранных"

msgid "All remaining servers"
msgstr "Все оставшиеся серверы"

msgid "All remaining servers means every server not already assigned to a higher-priority level."
msgstr "Добавляет все серверы, которые не попали в уровни с более высоким приоритетом."

msgid "All servers"
msgstr "Все серверы"

msgid "All traffic from these IP addresses will be routed through the section unconditionally, ignoring all other conditions."
msgstr "Весь трафик с этих IP-адресов будет направлен через секцию безусловно, игнорируя остальные условия."

msgid "All traffic: %d"
msgstr "Весь трафик: %d"

msgid "Allowed domain prefixes are full:, keyword:, and regex:"
msgstr "Разрешённые префиксы доменов: full:, keyword: и regex:"

msgid "Allows access to YACD from the WAN. Make sure to open the appropriate port in your firewall."
msgstr "Обеспечивает доступ к YACD из WAN. Убедитесь, что в брандмауэре открыт соответствующий порт."

msgid "Allows limiting the list of servers for URLTest"
msgstr "Позволяет ограничить список серверов для URLTest"

msgid "Always"
msgstr "Всегда"

msgid "An address without a DNS server answered on port 53. Use a DoH or DoT main DNS server."
msgstr "На порту 53 ответил адрес, где нет DNS-сервера. Используйте основной DNS-сервер DoH или DoT."

msgid "An administrator can roll it back."
msgstr "Откатить его может администратор."

msgid "An interrupted package update is being recovered. Avoid changes until it completes."
msgstr "Восстанавливается прерванное обновление пакетов. Не вносите изменений, пока оно не завершится."

msgid "An IP address needs no DNS"
msgstr "Для IP-адреса DNS не нужен"

msgid "and %d more"
msgstr "и ещё %d"

msgid "and %d more addresses"
msgstr "и ещё адресов: %d"

msgid "Anime"
msgstr "Аниме"

msgid "Another action of this kind is already running. Try again when it finishes."
msgstr "Уже выполняется другое такое же действие. Повторите, когда оно завершится."

msgid "Another autotune operation is running."
msgstr "Уже выполняется другая операция автоподбора."

msgid "another check is running"
msgstr "идёт другая проверка"

msgid "Another check was running."
msgstr "Шла другая проверка."

msgid "Another group was changed in this run; at most one change per run."
msgstr "В этой проверке уже изменена другая группа; не больше одного изменения за проверку."

msgid "Another snapshot operation is already in progress. Changes were not applied; try again in a moment."
msgstr "Уже выполняется другая операция со снимками. Изменения не применены, повторите через минуту."

msgid "Another snapshot operation is already in progress. Try again in a moment."
msgstr "Уже выполняется другая операция со снимками. Повторите через минуту."

msgid "Another TorrServer is installed or running on this router; Prokop does not replace it"
msgstr "На роутере уже установлен или запущен другой TorrServer; Prokop его не заменяет"

msgid "Another TorrServer is installed or running on this router. Prokop does not replace it; remove it first to install TorrServer from Prokop."
msgstr "На роутере уже установлен или запущен другой TorrServer. Prokop его не заменяет: удалите его, чтобы установить TorrServer из Prokop."

msgid "Another TorrServer runs on this router. Prokop does not start its own TorrServer or change settings while it runs; stop the other one first."
msgstr "На роутере работает другой TorrServer. Пока он работает, Prokop не запускает свой TorrServer и не меняет настройки; сначала остановите другой."

msgid "Answer of the router DNS"
msgstr "Ответ DNS роутера"

msgid "Any device"
msgstr "Любое устройство"

msgid "Applied and checked, but not confirmed as the working configuration"
msgstr "Применена и проверена, но не подтверждена как рабочая конфигурация"

msgid "Applied by reload"
msgstr "Применённая перезагрузкой"

msgid "Applied, check passed"
msgstr "Применена, проверка пройдена"

msgid "Apply"
msgstr "Применить"

msgid "Apply %s"
msgstr "Применить %s"

msgid "Apply %s?"
msgstr "Применить %s?"

msgid "Apply did not finish: configuration edited"
msgstr "Применение не завершено: конфигурацию изменили"

msgid "Apply recommended settings"
msgstr "Применить рекомендуемые"

msgid "Apply section rules only to the specified local IP addresses"
msgstr "Применять правила секции только к указанным локальным IP-адресам"

msgid "Apply the recommended TorrServer settings?"
msgstr "Применить рекомендуемые настройки TorrServer?"

msgid "Applying"
msgstr "Применение настройки"

msgid "Applying a strategy"
msgstr "Применяется стратегия"

msgid "Applying changes…"
msgstr "Применяются изменения…"

msgid "Applying Prokop configuration…"
msgstr "Применение конфигурации Prokop…"

msgid "Applying the change was not confirmed in time; check the service status."
msgstr "Применение изменения не подтвердилось вовремя; проверьте состояние службы."

msgid "Applying the new strategy did not finish: its reload did not succeed, and the configuration was changed meanwhile. Prokop kept that change instead of rolling back. Check the rule, or restore the snapshot you need in History and recovery."
msgstr "Применение новой стратегии не завершено: её перезагрузка не удалась, а конфигурацию тем временем изменили. Prokop сохранил это изменение вместо отката. Проверьте правило или восстановите нужный снимок в разделе «История и восстановление»."

msgid "Applying…"
