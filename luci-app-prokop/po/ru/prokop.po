msgid "-- Select --"
msgstr "-- Выберите --"

msgid "{count} domains of client-limited rules are not blocked through DNS (it is shared by all clients); only their IP lists and FakeIP answers are blocked while Prokop is stopped"
msgstr "Доменов из правил с ограничением по клиентам не блокируется через DNS (он общий для всех клиентов): {count}. Пока Prokop остановлен, блокируются только их IP-списки и ответы FakeIP"

msgid "{count} domains of device-limited rules of other VPN sections are not blocked by the standby resolver for a dead sing-box (DNS is shared by all clients)"
msgstr "Доменов из правил других VPN-секций с ограничением по устройствам не блокирует резервный резолвер при упавшем sing-box (DNS общий для всех клиентов): {count}"

msgid "{count} domains of rules with excluded devices are blocked through DNS for the excluded devices as well (it is shared by all clients) while Prokop is stopped"
msgstr "Доменов из правил с исключёнными устройствами, которые, пока Prokop остановлен, блокируются через DNS и для исключённых устройств (он общий для всех клиентов): {count}"

msgid "{keyword} keyword, {regex} regex and {inverted} inverted domain matchers cannot be enforced through DNS while Prokop is stopped"
msgstr "Пока Prokop остановлен, через DNS нельзя применить условия по домену: по ключевому слову — {keyword}, по regex — {regex}, инвертированных — {inverted}"

msgid "%d confirmations"
msgstr "подтверждений: %d"

msgid "%d connections now"
msgstr "Соединений сейчас: %d"

msgid "%d d"
msgstr "%d дн."

msgid "%d entries without a domain name are skipped"
msgstr "пропущено записей без доменного имени: %d"

