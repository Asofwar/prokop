msgstr "Сервис sing-box существует"

msgid "Sing-box version is compatible (newer than 1.12.4)"
msgstr "Версия Sing-box совместима (новее 1.12.4)"

msgid "Site, IP, device or rule"
msgstr "Сайт, IP, устройство или правило"

msgid "Snapshot actions"
msgstr "Действия со снимком"

msgid "Snapshot created"
msgstr "Снимок создан"

msgid "Snapshot deleted"
msgstr "Снимок удалён"

msgid "Snapshot not saved: at most %d manual snapshots are kept, so that the automatic snapshots taken before a restore, Save & Apply or autotune always have room. Delete a manual snapshot you no longer need, then try again."
msgstr "Снимок не сохранён: хранится не более %d ручных снимков, чтобы автоматическим снимкам перед восстановлением, «Сохранить и применить» или автоподбором всегда хватало места. Удалите ненужный ручной снимок и повторите."

msgid "Snapshot not saved: at most %d manual snapshots are kept, so that the automatic snapshots taken before a restore, Save & Apply or autotune always have room. There are %d manual snapshots now: delete %d you no longer need, then try again."
msgstr "Снимок не сохранён: хранится не более %d ручных снимков, чтобы автоматическим снимкам перед восстановлением, «Сохранить и применить» или автоподбором всегда хватало места. Сейчас ручных снимков: %d — удалите не меньше %d ненужных и повторите."

msgid "Snapshot not saved: it could not be written. Check the free space on the router."
msgstr "Снимок не сохранён: его не удалось записать. Проверьте свободное место на роутере."

msgid "Snapshot not saved: the configuration file could not be read."
msgstr "Снимок не сохранён: не удалось прочитать файл конфигурации."

msgid "Snapshot not saved: the snapshot storage could not be locked. Try again in a moment."
msgstr "Снимок не сохранён: хранилище снимков не удалось заблокировать. Повторите через минуту."

msgid "Snapshot restore"
msgstr "Восстановление снимка"

msgid "Snapshot saved"
msgstr "Снимок сохранён"

