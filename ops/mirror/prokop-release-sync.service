[Unit]
Description=Download and publish the latest signed Prokop release
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/storage/prokop-mirror

[Service]
Type=oneshot
User=prokop-mirror
Group=prokop-mirror
WorkingDirectory=/mnt/storage/prokop-mirror/config
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
Environment=MIRROR_ROOT=/mnt/storage/prokop-mirror/data/public/forkop
Environment=PROKOP_BUILD_ROOT=/mnt/storage/prokop-mirror/build/releases
Environment=PROKOP_RELEASE_LOCK_FILE=/mnt/storage/prokop-mirror/data/.prokop-release-sync.lock
Environment=PROKOP_PUBLISH_COMMAND=/usr/local/sbin/publish-prokop-feed
Environment=PROKOP_APK_PRIVATE_KEY=/mnt/storage/prokop-mirror/keys/forkop-apk.pem
Environment=APK_BIN=/mnt/storage/prokop-mirror/tools/apk-runtime/bin/apk
ExecStart=/usr/bin/python3 /mnt/storage/prokop-mirror/config/sync-prokop-release.py
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=25%
MemoryMax=256M
MemorySwapMax=0
TasksMax=16
IOWeight=10
IOReadBandwidthMax=/mnt/storage 4M
IOWriteBandwidthMax=/mnt/storage 4M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/mnt/storage/prokop-mirror/data /mnt/storage/prokop-mirror/build /mnt/storage/prokop-mirror/keys
UMask=0022
TimeoutStartSec=15min
